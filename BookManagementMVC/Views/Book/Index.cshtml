@model List<BookManagementMVC.Models.Book>

<h2>Book Management - Danh sách sách</h2>

<table border="1" cellpadding="10">
<tr>
    <th>Id</th>
    <th>Name</th>
    <th>Price</th>
    <th></th>
</tr>

@foreach(var book in Model)
{
<tr>
    <td>@book.Id</td>
    <td>@book.Name</td>
    <td>@book.Price</td>
    <td>
        <a href="/Book/Detail/@book.Id">Chi tiết</a>
    </td>
</tr>
}
</table>

<br/>

<a href="/Book/Create">Thêm sách</a>